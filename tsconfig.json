{
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "allowJs": true,
    "jsx": "react",
    /*
      TypeScript 7 removed "node" (node10). "bundler" is the correct successor here: Vite does
      the resolving, so the compiler should model a bundler's rules — package "exports" maps
      honoured, no mandatory file extensions — rather than Node's 2015 CommonJS lookup.
    */
    "moduleResolution": "bundler",
    "module": "ESNext",
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedModules": true,
    "strict": true,
    "outDir": "./dist"
  },
  "include": [
    "assets.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "app/bootstrap/ssr"
  ]
}